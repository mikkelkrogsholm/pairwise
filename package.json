{
  "name": "pairwise-ideas",
  "version": "0.1.0",
  "description": "A simple, modern, self-hostable pairwise voting tool inspired by All Our Ideas. Bun + SQLite.",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "seed:dr-top100": "bun scripts/seed-dr-top100.ts",
